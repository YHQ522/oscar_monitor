[Unit]
Description=oscar-monitor 数据库监控管控平台
Documentation=https://github.com/your-org/oscar_monitor
After=network.target

[Service]
Type=simple
# 修改为实际部署路径
WorkingDirectory=/opt/oscar_monitor/backend
ExecStart=/opt/oscar_monitor/backend/.venv/bin/python run.py --host 0.0.0.0 --port 5080
Restart=always
RestartSec=5

# 生产环境务必设置（>=32 字节随机串，可用: python -c "import secrets;print(secrets.token_hex(32))"）
Environment=OSCAR_SECRET_KEY=please-replace-with-a-random-32-plus-byte-secret
# 存储后端: json（默认）| sqlite
Environment=OSCAR_STORAGE_BACKEND=json
# 可选：关闭日志持久化/调整采集并发
# Environment=OSCAR_COLLECT_WORKERS=8

# 以非 root 运行更安全
User=oscar
Group=oscar

[Install]
WantedBy=multi-user.target
